@prefix ogit:    	<http://www.purl.org/ogit/> .
@prefix rdfs:    	<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     	<http://www.w3.org/2002/07/owl#> .
@prefix dcterms: 	<http://purl.org/dc/terms/> .
@prefix ogit.PublicAdministration: <http://www.purl.org/ogit/PublicAdministration/> .

ogit.PublicAdministration:Evidence
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "Evidence";
	dcterms:description """A document required for or produced by a public service.""";
	# For ranges, see https://www.dublincore.org/specifications/dublin-core/dcmi-period/
	dcterms:valid "start=2026-10-05;";
	dcterms:creator "Daniel Brommer";
	ogit:scope "NTO";
	ogit:parent ogit:Node;
	ogit:blob "true";
	ogit:mandatory-attributes (
	);
	ogit:optional-attributes (
		ogit:name
		ogit:description
		ogit:type
		ogit.PublicAdministration:signatureRequirement
		ogit.PublicAdministration:issuedBy
		ogit:validFrom
		ogit:validTo
		ogit:reviewedAt
		ogit:source
	);
	ogit:indexed-attributes (
	);
	ogit:allowed (
		[ ogit:describes  ogit.PublicAdministration:PublicService ]
		[ ogit.PublicAdministration:overrides  ogit.PublicAdministration:Evidence ]
		[ ogit:extends  ogit.PublicAdministration:Evidence ]
		[ ogit:contains  ogit.PublicAdministration:Evidence ]
		[ ogit:proves  ogit.PublicAdministration:PublicRequirement ]
		[ ogit:generatedFrom  ogit.PublicAdministration:TextualInformation ]
		[ ogit:validFor  ogit:Region ]
		[ ogit:validFor  ogit.PublicAdministration:CharacteristicValue ]
	);
.
