@prefix ogit:    	<http://www.purl.org/ogit/> .
@prefix rdfs:    	<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     	<http://www.w3.org/2002/07/owl#> .
@prefix dcterms: 	<http://purl.org/dc/terms/> .
@prefix ogit.PublicAdministration: <http://www.purl.org/ogit/PublicAdministration/> .

ogit.PublicAdministration:PublicTenant
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "PublicTenant";
	dcterms:description """An area of editorial responsibility that maintains public administration data.""";
	# For ranges, see https://www.dublincore.org/specifications/dublin-core/dcmi-period/
	dcterms:valid "start=2026-10-05;";
	dcterms:creator "Daniel Brommer";
	ogit:scope "NTO";
	ogit:parent ogit:Node;
	ogit:mandatory-attributes (
	);
	ogit:optional-attributes (
		ogit:id
		ogit:name	
		ogit:description
		ogit:type
		ogit:source
		ogit:status
		ogit:validFrom
		ogit:validTo
	);
	ogit:indexed-attributes (
	);
	ogit:allowed (
		[ ogit:belongs  ogit.PublicAdministration:PublicOrganisation ]
		[ ogit:isResponsibleFor  ogit.PublicAdministration:TextualInformation ]
		[ ogit:isResponsibleFor  ogit.PublicAdministration:Cost ]
		[ ogit:isResponsibleFor  ogit.PublicAdministration:Deadline ]
		[ ogit:isResponsibleFor  ogit.PublicAdministration:ProcessingTime ]
		[ ogit:isResponsibleFor  ogit.PublicAdministration:Evidence ]
		[ ogit:isResponsibleFor  ogit.PublicAdministration:PublicRequirement ]
		[ ogit:isResponsibleFor  ogit.PublicAdministration:Competence ]
		[ ogit:isResponsibleFor  ogit.PublicAdministration:CitizenForm ]
		[ ogit:isResponsibleFor  ogit.PublicAdministration:PublicOrganisation ]
	);
.
