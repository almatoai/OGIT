@prefix ogit:    	<http://www.purl.org/ogit/> .
@prefix rdfs:    	<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     	<http://www.w3.org/2002/07/owl#> .
@prefix dcterms: 	<http://purl.org/dc/terms/> .
@prefix ogit.PublicAdministration: <http://www.purl.org/ogit/PublicAdministration/> .

ogit.PublicAdministration:ContactPoint
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "ContactPoint";
	dcterms:description """A single communication channel of an organisation, site or person.""";
	# For ranges, see https://www.dublincore.org/specifications/dublin-core/dcmi-period/
	dcterms:valid "start=2026-10-05;";
	dcterms:creator "Daniel Brommer";
	ogit:scope "NTO";
	ogit:parent ogit:Node;
	ogit:mandatory-attributes (
		ogit:type
	);
	ogit:optional-attributes (
		ogit:email
		ogit:description
		ogit:validFrom
		ogit:validTo
		ogit:source
	);
	ogit:indexed-attributes (
	);
	ogit:allowed (
		[ ogit:assignedTo  ogit:Person ]
	);
.
