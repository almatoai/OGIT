@prefix rdfs:    	<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     	<http://www.w3.org/2002/07/owl#> .
@prefix dcterms: 	<http://purl.org/dc/terms/> .
@prefix ogit:    	<http://www.purl.org/ogit/> .
@prefix ogit.Legal: <http://www.purl.org/ogit/Legal/> .
@prefix ogit.Forms: <http://www.purl.org/ogit/Forms/> .
@prefix ogit.Documents: <http://www.purl.org/ogit/Documents/> .
@prefix ogit.ServiceManagement: <http://www.purl.org/ogit/ServiceManagement/> .

ogit.Forms:Form
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "Form";
	dcterms:description """A form to fill out the different fields with information.""";
	# For ranges, see https://www.dublincore.org/specifications/dublin-core/dcmi-period/
	dcterms:valid "start=2025-05-30;";
	dcterms:creator "Semih Can Sancar";
	ogit:scope "NTO";
	ogit:parent ogit:Node;
	ogit:blob "true";
	ogit:mandatory-attributes (
		ogit:id
	);
	ogit:optional-attributes (
		ogit:name
		ogit:version
		ogit:content
		ogit:status
		ogit:description
		ogit:subType
		ogit:type
		ogit:tenantId
		ogit:favorite
		ogit:email
		ogit:followers
		ogit:url
	);
	ogit:indexed-attributes (
		ogit:name
		ogit:id
		ogit:description
	);
	ogit:allowed (
		[ ogit:references  ogit.Forms:Form ]
		[ ogit:uses  ogit.Forms:Form ]
		[ ogit:contains  ogit.Forms:FormFieldGroup ]
		[ ogit:contains  ogit.Forms:FormField ]
		[ ogit:complies  ogit.Legal:LegalClause ]
		[ ogit:complies  ogit.Legal:LegalNorm ]
		[ ogit:has       ogit:Attachment ]
		[ ogit:precedes  ogit.Forms:Form]
		[ ogit:generatedFrom  ogit.Documents:Document ]
		[ ogit:generatedFrom  ogit.Forms:Form ]
		[ ogit:generatedFrom  ogit.Legal:LegalClause ]
		[ ogit:generatedFrom  ogit.ServiceManagement:Service ]
	);
.
