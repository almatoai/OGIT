@prefix ogit.Auth.Application:  <http://www.purl.org/ogit/Auth/Application/> .
@prefix ogit:                   <http://www.purl.org/ogit/> .
@prefix owl:                    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ogit.Auth:              <http://www.purl.org/ogit/Auth/> .
@prefix dcterms:                <http://purl.org/dc/terms/> .

ogit.Auth.Application:route
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "route";
	dcterms:description "The backend components a desktop application requires, as a string. Set on the desktop application, so that what it depends on is readable from the application itself. The counterpart is ogit/Auth/Application/whitelist, which the required component sets.";
	# For ranges, see https://www.dublincore.org/specifications/dublin-core/dcmi-period/
	dcterms:valid "start=2026-09-08;";
	dcterms:creator "Andreas Schmid";
	dcterms:created "2026-09-08";
	dcterms:modified "2026-09-08";
.
