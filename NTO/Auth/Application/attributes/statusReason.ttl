@prefix ogit.Auth.Application:  <http://www.purl.org/ogit/Auth/Application/> .
@prefix ogit:                   <http://www.purl.org/ogit/> .
@prefix owl:                    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ogit.Auth:              <http://www.purl.org/ogit/Auth/> .
@prefix dcterms:                <http://purl.org/dc/terms/> .

ogit.Auth.Application:statusReason
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "statusReason";
	dcterms:description "Why the application reached its current status. Carries the reason a deactivated application was deactivated, which together with the provenance is the only record of what the organization was running.";
	# For ranges, see https://www.dublincore.org/specifications/dublin-core/dcmi-period/
	dcterms:valid "start=2026-09-04;";
	dcterms:creator "Viktor Voss";
	dcterms:created "2026-09-04";
	dcterms:modified "2026-09-04";
.
