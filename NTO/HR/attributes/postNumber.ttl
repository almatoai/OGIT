@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.HR:              <http://www.purl.org/ogit/HR/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.HR:postNumber
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "postNumber";
	dcterms:description """Identifier of a single post (Stellennummer) within the
	employing organization's establishment plan (Stellenplan). One value per
	post, not per employer -- an employer-level registration number such as a
	Betriebsnummer identifies the employer and is one resolution level too
	coarse. Unique within the employing organization only. Alphanumeric, not an
	integer. Named postNumber rather than positionNumber because ogit:positionNumber
	already means an ordinal, a place in a sequence.""";
	dcterms:valid "start=2026-08-16;";
	dcterms:creator "Almato AG";
.
