@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.HR:              <http://www.purl.org/ogit/HR/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.HR:authorityKind
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "authorityKind";
	dcterms:description "Kind of authority delegated to the holder of a position. Unrelated to the similarly named attribute in the Integration namespace, which denotes data provenance.";
	ogit:validation-type "fixed";
	ogit:validation-parameter "signature,decision,directive,committeeRepresentation";
	dcterms:valid "start=2026-08-16;";
	dcterms:creator "Almato AG";
.
