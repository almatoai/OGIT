@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.HR:              <http://www.purl.org/ogit/HR/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.HR:assignedGrade
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "assignedGrade";
	dcterms:description "The pay grade assigned by a grading, expressed as the category identifier of the corresponding classification-standard node, e.g. E11.";
	dcterms:valid "start=2026-08-16;";
	dcterms:creator "Almato AG";
.
