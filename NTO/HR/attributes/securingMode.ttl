@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.HR:              <http://www.purl.org/ogit/HR/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.HR:securingMode
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "securingMode";
	dcterms:description "How a grading result is secured: derivable from norms, context and precedent, or established statistically through convergence and confidence.";
	ogit:validation-type "fixed";
	ogit:validation-parameter "derivable,statistical";
	dcterms:valid "start=2026-08-16;";
	dcterms:creator "Almato AG";
.
