@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.HR:              <http://www.purl.org/ogit/HR/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.HR:authorityScope
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "authorityScope";
	dcterms:description "Whether an authority may be exercised only within the organization or also towards third parties.";
	ogit:validation-type "fixed";
	ogit:validation-parameter "internal,external";
	dcterms:valid "start=2026-08-16;";
	dcterms:creator "Almato AG";
.
