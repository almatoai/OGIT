@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.HR:              <http://www.purl.org/ogit/HR/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.HR:trainingDuration
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "trainingDuration";
	dcterms:description "Nominal duration of the training or course of study leading to an occupation, as stated by the register.";
	dcterms:valid "start=2026-08-17;";
	dcterms:creator "Almato AG";
.
