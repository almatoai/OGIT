@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.HR:              <http://www.purl.org/ogit/HR/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.HR:institutionType
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "institutionType";
	dcterms:description "Type of institution the required degree must come from, where the distinction carries evaluative weight (for example university versus university of applied sciences).";
	ogit:validation-type "fixed";
	ogit:validation-parameter "university,universityOfAppliedSciences,vocationalSchool,other";
	dcterms:valid "start=2026-08-16;";
	dcterms:creator "Almato AG";
.
