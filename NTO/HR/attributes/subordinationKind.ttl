@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.HR:              <http://www.purl.org/ogit/HR/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.HR:subordinationKind
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "subordinationKind";
	dcterms:description "Whether staff are subordinate to a position in a functional sense, a disciplinary sense, or both.";
	ogit:validation-type "fixed";
	ogit:validation-parameter "functional,disciplinary,functionalAndDisciplinary";
	dcterms:valid "start=2026-08-16;";
	dcterms:creator "Almato AG";
.
