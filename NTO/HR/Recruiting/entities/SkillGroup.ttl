@prefix ogit.HR.Recruiting:     <http://www.purl.org/ogit/HR/Recruiting/> .
@prefix ogit:                   <http://www.purl.org/ogit/> .
@prefix rdfs:                   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:                <http://purl.org/dc/terms/> .

ogit.HR.Recruiting:SkillGroup
  a rdfs:Class;
  rdfs:subClassOf ogit:Entity;
  rdfs:label "SkillGroup";
  dcterms:description """A group of skills. Where the skills are taken from a
  published catalogue, the group can be that catalogue or one edition of it
  (e.g. a training regulation): identifierCode and codeType name it, url
  points at the source, version names the edition and validFrom/validTo
  its period of validity.""";
  dcterms:valid "start=2019-03-21;";
  dcterms:creator "Florian Fluegel";
  ogit:scope "NTO";
  ogit:parent ogit:Node;
  ogit:mandatory-attributes (
    ogit:name
  );
  ogit:optional-attributes (
    ogit:description
    ogit:identifierCode
    ogit:codeType
    ogit:url
    ogit:version
    ogit:validFrom
    ogit:validTo
  );
  ogit:indexed-attributes (
    ogit:name
    ogit:identifierCode
  );
  ogit:allowed (
  );

.
