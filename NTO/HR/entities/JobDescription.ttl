@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.HR:              <http://www.purl.org/ogit/HR/> .
@prefix ogit.Forms:           <http://www.purl.org/ogit/Forms/> .
@prefix ogit.Automation:      <http://www.purl.org/ogit/Automation/> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.HR:JobDescription
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "JobDescription";
	dcterms:description """A job description (Stellenbeschreibung): the documented
	account of a position's purpose, required qualification, organizational
	embedding, authorities and work units. It is the evidentiary basis on which a
	position is evaluated and graded, and it is versioned in its own right -- a
	position may be described more than once over time, and each description can
	be graded separately.""";
	dcterms:valid "start=2026-08-16;";
	dcterms:creator "Almato AG";
	ogit:scope "NTO";
	ogit:parent ogit:Node;
	ogit:mandatory-attributes (
		ogit:name
	);
	ogit:optional-attributes (
		ogit.HR:postNumber
		ogit:description
		ogit:content
		ogit:status
		ogit:validFrom
		ogit:validTo
	);
	ogit:indexed-attributes (
		ogit:name
		ogit.HR:postNumber
	);
	ogit:allowed (
		[ ogit:describes   ogit.HR:Position ]
		[ ogit:contains    ogit.HR:WorkUnit ]
		[ ogit:requires    ogit.HR:QualificationRequirement ]
		[ ogit:defines     ogit.HR:Authority ]
		[ ogit:has         ogit.HR:Subordination ]
		[ ogit:has         ogit.HR:Grading ]
		[ ogit:represents  ogit.Forms:Form ]
		[ ogit:relates     ogit.Automation:AutomationIssue ]
	);
.
