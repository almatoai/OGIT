@prefix ogit:                            <http://www.purl.org/ogit/> .
@prefix ogit.HR:                         <http://www.purl.org/ogit/HR/> .
@prefix ogit.Legal:                      <http://www.purl.org/ogit/Legal/> .
@prefix ogit.ClassificationStandard:     <http://www.purl.org/ogit/ClassificationStandard/> .
@prefix rdfs:                            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:                         <http://purl.org/dc/terms/> .

ogit.HR:Occupation
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "Occupation";
	dcterms:description """A recognised occupation as a public register states
	it. The register describes one occupation from two sides that say different
	things -- the education (curriculum, nominal duration, legal basis) and the
	occupation as practised (activities, competences) -- and occupationKind says
	which side an entry is; they reference each other rather than being merged.
	A requirement that names such an occupation should point at the entry rather
	than restate it, so what the training covers stays available to evaluation.
	Activities are carried in ogit:values, one per line, as a WorkUnit carries
	its sub-items. Both ogit:values and the curriculum in ogit:content are
	indexed, because the comparison this entry serves is content against
	content and has to reach the wording, not only the entry.
	ogit:source names the register and edition, so a later edition is a visible
	replacement rather than an invisible drift; it is not indexed, since every
	entry of one load repeats it.""";
	dcterms:valid "start=2026-08-17;";
	dcterms:creator "Almato AG";
	ogit:scope "NTO";
	ogit:parent ogit:Node;
	ogit:mandatory-attributes (
		ogit:name
	);
	ogit:optional-attributes (
		ogit.HR:occupationCode
		ogit.HR:occupationKind
		ogit.HR:trainingDuration
		ogit.HR:competences
		ogit:values
		ogit:description
		ogit:content
		ogit:url
		ogit:source
		ogit:validFrom
		ogit:validTo
	);
	ogit:indexed-attributes (
		ogit:name
		ogit:description
		ogit:values
		ogit:content
		ogit.HR:competences
		ogit.HR:occupationCode
	);
	ogit:allowed (
		[ ogit.ClassificationStandard:classifiedUnder  ogit.ClassificationStandard:ClassificationStandardTreeBranch ]
		[ ogit:references  ogit.Legal:LegalNorm ]
		[ ogit:relates     ogit.HR:Occupation ]
	);
.
