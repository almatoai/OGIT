@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:mappingRulesPayload
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "mappingRulesPayload";
	dcterms:description "JSON (RFC 8259, https://www.rfc-editor.org/rfc/rfc8259) of the blueprint's mapping tree that a run executes: the blueprint's root node with its rules and child nodes, and the version of the blueprint language.";
	dcterms:valid "start=2026-05-21;";
	dcterms:creator "Almato AG";
.
