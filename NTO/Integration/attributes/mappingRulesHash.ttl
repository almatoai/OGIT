@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:mappingRulesHash
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "mappingRulesHash";
	dcterms:description "Integrity checksum of the blueprint version a run executes: the SHA-256 hash (FIPS 180-4, https://doi.org/10.6028/NIST.FIPS.180-4), in lowercase hex, of the whole blueprint in a serialisation that does not depend on formatting or key order, without the blueprint's own signature field. Deprecated: replaced by ogit:contentDigest.";
	dcterms:valid "start=2026-05-21;";
	dcterms:creator "Almato AG";
.
