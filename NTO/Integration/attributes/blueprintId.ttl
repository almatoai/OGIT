@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:blueprintId
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "blueprintId";
	dcterms:description "Identifier of a blueprint, the same for all its versions and unique within an organization. Together with the organization and ogit:version it names one Connector.";
	dcterms:valid "start=2026-11-19;";
	dcterms:creator "Almato AG";
.
