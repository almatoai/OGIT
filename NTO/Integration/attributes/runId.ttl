@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:runId
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "runId";
	dcterms:description "Identifier of one run of a connector, unique within a connector framework installation: a ULID (https://github.com/ulid/spec).";
	dcterms:valid "start=2026-11-19;";
	dcterms:creator "Almato AG";
.
