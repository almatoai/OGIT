@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:nettingPolicyPayload
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "nettingPolicyPayload";
	dcterms:description "JSON (RFC 8259, https://www.rfc-editor.org/rfc/rfc8259) of the blueprint's netting policy for a run. Netting is how the connector framework combines and throttles writes before they reach the graph: coalescing of repeated changes, batching and backpressure. The value is recorded with the run; the connector framework does not apply it.";
	dcterms:valid "start=2026-05-21;";
	dcterms:creator "Almato AG";
.
