@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:matchCriteria
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "matchCriteria";
	dcterms:description "JSON list (RFC 8259, https://www.rfc-editor.org/rfc/rfc8259) of attribute pairs, each with left_attribute (on the source vertex) and right_attribute (on the target vertex). A target vertex matches a source vertex when, for every pair, its right_attribute equals the source's left_attribute exactly, case included.";
	dcterms:valid "start=2026-05-21;";
	dcterms:creator "Almato AG";
.
