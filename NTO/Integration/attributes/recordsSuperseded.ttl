@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:recordsSuperseded
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "recordsSuperseded";
	dcterms:description "Number of records of a run that a later record for the same source record replaced before they were written; not a failure.";
	dcterms:valid "start=2026-11-19;";
	dcterms:creator "Almato AG";
.
