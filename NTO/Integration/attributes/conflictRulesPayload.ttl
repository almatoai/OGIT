@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:conflictRulesPayload
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "conflictRulesPayload";
	dcterms:description "JSON list (RFC 8259, https://www.rfc-editor.org/rfc/rfc8259) of the conflict rules a run applies. Blueprints carry no conflict rules, so the value is an empty list; when two connectors write the same attribute of a vertex, the later write wins. Deprecated: carries no information.";
	dcterms:valid "start=2026-05-21;";
	dcterms:creator "Almato AG";
.
