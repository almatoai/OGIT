@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:sourceVertexPattern
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "sourceVertexPattern";
	dcterms:description "Vertices a weaving rule starts from: an OGIT entity type, optionally followed by attribute filters in brackets, e.g. ogit/Transport/Airport or ogit/Region[ogit/type=\"country\"].";
	dcterms:valid "start=2026-05-21;";
	dcterms:creator "Almato AG";
.
