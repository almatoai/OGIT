@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:scheduleCron
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "scheduleCron";
	dcterms:description "Cron expression (crontab format, IEEE Std 1003.1, utility crontab) that scheduled a weaving rule. Deprecated: a weaving rule runs after each run of the connector that declares it; the connector framework does not write or read this attribute.";
	dcterms:valid "start=2026-05-21;";
	dcterms:creator "Almato AG";
.
