@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:celPredicate
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "celPredicate";
	dcterms:description "Expression in the Common Expression Language (CEL, https://github.com/google/cel-spec) that a pair of vertices had to satisfy to be connected by a weaving rule. Deprecated: a weaving rule matches by attribute equality only (matchCriteria); the connector framework does not write or read this attribute.";
	dcterms:valid "start=2026-05-21;";
	dcterms:creator "Almato AG";
.
