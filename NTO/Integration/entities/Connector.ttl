@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:Connector
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "Connector";
	dcterms:description """A published, versioned blueprint that defines a
	connection between Bardioc and a single source system. The blueprint is a
	signed document and the Connector CARRIES it, in ogit:content, with
	ogit:mimeType naming the serialisation. The document embeds its own
	integrity hash under its "signature" key, so no separate hash attribute
	exists: that value has one owner. The rules inside it -- field mappings,
	transforms, netting, conflict resolution -- are parts of that document and
	are deliberately not modelled as vertices. Weaving rules are the exception
	and are declared as vertices, because a framework runtime builds them. A
	Connector is instantiated at deploy time as one or more ConnectorInstances.
	Per PLAN D6 (eight stages, three trigger modes) and D11 (NTO/Integration).""";
	dcterms:valid "start=2026-05-21;";
	dcterms:creator "Almato AG";
	ogit:scope "NTO";
	ogit:parent ogit:Node;
	ogit:mandatory-attributes (
		ogit:version
		ogit.Integration:frameworkMin
		ogit.Integration:frameworkMax
	);
	ogit:optional-attributes (
		ogit.Integration:sourceSystemId
		ogit:author
		ogit.Integration:signingCertificateRef
		ogit.Integration:deprecationPhase
		ogit:content
		ogit:mimeType
	);
	ogit:indexed-attributes (
		ogit:version
		ogit.Integration:sourceSystemId
	);
	ogit:allowed (
		[ ogit:contains ogit.Integration:WeavingRule ]
	);
.
