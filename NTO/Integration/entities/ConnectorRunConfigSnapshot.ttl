@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix ogit.Auth:            <http://www.purl.org/ogit/Auth/> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:ConnectorRunConfigSnapshot
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "ConnectorRunConfigSnapshot";
	dcterms:description """The record of one run of a connector. A run is one execution of a connector
	under one blueprint version (see Connector), writing into one data scope.
	The record carries the rules the run executes, frozen when the run opens
	(snapshotTakenAt): the run keeps exactly these rules across a restart of the
	connector framework, and a change to the blueprint takes effect with the next
	run. It also carries the run's identity and state, which change while the
	run goes on. The run is identified by runId; feedId names the feed the run
	belongs to; ogit.Auth:scopeId is the data scope the run writes into;
	blueprintId, ogit:version and ogit.Auth:organizationId name the Connector
	whose blueprint the run executes -- the organization is the one the run's
	token acts for, which can differ from the organization of the data scope.
	ogit:status is one of open, paused, ended (no further records are accepted;
	accepted records may still be written) or complete (ended, and every
	accepted record reached a final state). ogit:endedAt, endReason and
	discardCause are set when the run ends. ogit:contentDigest is the digest of
	the blueprint version the run executes, taken over the blueprint in a
	serialisation that does not depend on formatting or key order, without the
	blueprint's own signature field. The records* counts are those last
	recorded; they are final once ogit:status is complete. Internal bookkeeping
	of the connector framework, written and read only by it.""";
	dcterms:valid "start=2026-05-21;";
	dcterms:creator "Almato AG";
	ogit:scope "NTO";
	ogit:parent ogit:Node;
	ogit:mandatory-attributes (
		ogit.Integration:snapshotTakenAt
		ogit:version
		ogit.Integration:mappingRulesPayload
	);
	ogit:optional-attributes (
		ogit.Integration:nettingPolicyPayload
		ogit.Integration:conflictRulesPayload
		ogit.Integration:identityResolverConfigPayload
		ogit.Integration:sovereigntyManifestPayload
		ogit.Integration:weavingRulesPayload
		ogit.Integration:actionPolicyPayload
		ogit.Integration:dataClassificationPayload
		ogit.Integration:mappingRulesHash
		ogit:contentDigest
		ogit.Integration:runId
		ogit.Integration:blueprintId
		ogit.Auth:organizationId
		ogit.Auth:scopeId
		ogit.Integration:feedId
		ogit:status
		ogit:endedAt
		ogit.Integration:endReason
		ogit.Integration:discardCause
		ogit.Integration:recordsAccepted
		ogit.Integration:recordsWritten
		ogit.Integration:recordsSuperseded
		ogit.Integration:recordsDeadLettered
		ogit.Integration:recordsDiscarded
	);
	ogit:indexed-attributes (
		ogit:contentDigest
		ogit.Integration:blueprintId
		ogit.Auth:scopeId
		ogit:status
	);
	ogit:allowed ( );
.
