@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.Integration:     <http://www.purl.org/ogit/Integration/> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.Integration:WeavingRule
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "WeavingRule";
	dcterms:description """A rule of a blueprint (see Connector) that draws edges between vertices
	already in the graph. After each run of the connector that declares it, every
	vertex matching sourceVertexPattern is connected by an edge of edgeType to
	every vertex matching targetVertexPattern whose attributes equal its own as
	listed in matchCriteria. An edge that exists is not written again, and an edge
	whose match no longer holds is not removed. The full rule is carried as JSON in
	ogit:content. One vertex per rule and blueprint version, contained by its
	Connector; blueprintId names the blueprint and weaverId the rule within it.""";
	dcterms:valid "start=2026-05-21;";
	dcterms:creator "Almato AG";
	ogit:scope "NTO";
	ogit:parent ogit:Node;
	ogit:mandatory-attributes (
		ogit.Integration:weaverId
		ogit.Integration:sourceVertexPattern
		ogit.Integration:targetVertexPattern
		ogit.Integration:edgeType
	);
	ogit:optional-attributes (
		ogit.Integration:blueprintId
		ogit.Integration:matchCriteria
		ogit.Integration:celPredicate
		ogit.Integration:scheduleCron
		ogit:content
		ogit:mimeType
	);
	ogit:indexed-attributes (
		ogit.Integration:weaverId
		ogit.Integration:edgeType
		ogit.Integration:blueprintId
	);
	ogit:allowed (
	);
.
