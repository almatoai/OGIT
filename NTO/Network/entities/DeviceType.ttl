@prefix ogit.Network:           <http://www.purl.org/ogit/Network/> .
@prefix ogit.MRP:               <http://www.purl.org/ogit/MRP/> .
@prefix ogit:                   <http://www.purl.org/ogit/> .
@prefix rdfs:                   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:                <http://purl.org/dc/terms/> .

ogit.Network:DeviceType
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "DeviceType";
	dcterms:description "A model of hardware device as offered by a manufacturer. All devices of the same type share its physical characteristics, such as the space it occupies in a rack and its weight.";
	dcterms:valid "start=2026-08-31;";
	dcterms:creator "Erik Wilfling";
	ogit:scope "NTO";
	ogit:parent ogit:Node;
	ogit:mandatory-attributes (
		
	);
	ogit:optional-attributes (
		ogit:id
		ogit:model
		ogit:description
		ogit:capacity
		ogit:weight
		ogit.MRP:partNumber
		ogit:lastUpdatedAt
	);
	ogit:indexed-attributes (
		
	);
	ogit:allowed (
			[ ogit:has ogit:Tag ]
	);
.
