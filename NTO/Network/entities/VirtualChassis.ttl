@prefix ogit.Network:           <http://www.purl.org/ogit/Network/> .
@prefix ogit:                   <http://www.purl.org/ogit/> .
@prefix rdfs:                   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:                <http://purl.org/dc/terms/> .

ogit.Network:VirtualChassis
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "VirtualChassis";
	dcterms:description "A group of separate physical devices that presents itself to the network as one logical device, sharing a single control plane and management address. Unlike ogit.Network:NetworkEnclosure, the grouping is logical: the members stay independent pieces of hardware.";
	dcterms:valid "start=2026-08-31;";
	dcterms:creator "Erik Wilfling";
	ogit:scope "NTO";
	ogit:parent ogit:Node;
	ogit:mandatory-attributes (
		
	);
	ogit:optional-attributes (
		ogit:name
		ogit:id
		ogit:description
		ogit:lastUpdatedAt
	);
	ogit:indexed-attributes (
		
	);
	ogit:allowed (
			[ ogit:contains  ogit:Device ]
			[ ogit:has  ogit:Tag ]
	);
.
