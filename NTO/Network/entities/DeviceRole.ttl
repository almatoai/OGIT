@prefix ogit.Network:           <http://www.purl.org/ogit/Network/> .
@prefix ogit:                   <http://www.purl.org/ogit/> .
@prefix rdfs:                   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:                <http://purl.org/dc/terms/> .

ogit.Network:DeviceRole
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "DeviceRole";
	dcterms:description "The function a device fulfils in a network, such as access switch, core router or firewall. Devices sharing a role are managed and monitored alike.";
	dcterms:valid "start=2026-08-31;";
	dcterms:creator "Erik Wilfling";
	ogit:scope "NTO";
	ogit:parent ogit:Node;
	ogit:mandatory-attributes (
		
	);
	ogit:optional-attributes (
		ogit:name
		ogit:id
		ogit:description
		ogit:color
		ogit:lastUpdatedAt
	);
	ogit:indexed-attributes (
		
	);
	ogit:allowed (
			[ ogit:has ogit:Tag ]
	);
.
