@prefix ogit:                   <http://www.purl.org/ogit/> .
@prefix rdfs:                   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:                <http://purl.org/dc/terms/> .

ogit:Error
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "Error";
	dcterms:description "An error that occurred during the execution of a system, service or process.";
	dcterms:valid "start=2026-11-05;";
	dcterms:creator "Frauke Andersen";
	ogit:scope "SGO";
	ogit:parent ogit:Node;
	ogit:mandatory-attributes (
		
	);
	ogit:optional-attributes (
		ogit:name
		ogit:id
		ogit:message
		ogit:type
	);
	ogit:indexed-attributes (
		
	);
	ogit:allowed (
        
	);
.
